# =====================================================================
# e4 — public repo. Keep ONLY the reusable system here.
# Personal/work content stays local (untracked). When in doubt, leave it out.
# =====================================================================

# --- Personal identity (kept local; copy the *.example.md files to start) ---
/User/profile.md
/User/coding-standards.md

# --- Personal/work content: keep only each folder's README in the public repo ---
/DailyLogs/*
!/DailyLogs/README.md
/Projects/*
!/Projects/README.md
/Archive/**
!/Archive/README.md

# --- Secrets (defense in depth — these must never live in this repo) ---
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
.credentials*
secrets.*

# --- Obsidian per-machine state (plugin config IS shared; workspace is not) ---
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- Python ---
__pycache__/
*.pyc

# --- Distribution archives ---
*.zip
*.tar.gz
